{
  "name": "voidchop",
  "version": "1.2.3",
  "main": "main.js",
  "build": {
    "asarUnpack": [
      "ffmpeg/**"
    ],
    "appId": "com.taterz.spud",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "trimmer.js",
      "index.html",
      "style.css",
      "ffmpeg/**",
      "assets/**",
      "settings.json"
    ],
    "directories": {
      "output": "dist/VoidChop"
    },
    "win": {
      "target": "nsis",
      "icon": "icon/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "C4Taterz",
      "repo": "VoidChop"
    }
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "dotenv": "^17.0.0",
    "electron-log": "^5.4.1",
    "electron-updater": "^6.6.2",
    "fluent-ffmpeg": "^2.1.3",
    "update-electron-app": "^3.1.1"
  },
  "devDependencies": {
    "electron": "^37.1.0",
    "electron-builder": "^26.0.12"
  }
}
